FROM python:3.11-slim
WORKDIR /srv/ifund
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 IFUND_ENV=production IFUND_AUTO_MIGRATE=0 IFUND_OPEN_REQUIRE_BASE_WATERMARK=1
COPY backend/requirements-open.txt /srv/ifund/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --system --uid 10001 --home /srv/ifund ifund
RUN mkdir -p /runtime /cache && chown 10001:10001 /runtime /cache
COPY backend /srv/ifund
COPY config/open-data /srv/ifund/config/open-data
COPY --from=collection_runtime runtime /opt/collection-runtime/runtime
USER 10001
EXPOSE 8000
CMD ["python", "open_data_service.py"]
