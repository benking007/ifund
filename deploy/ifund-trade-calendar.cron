# iFund unified trade calendar: monthly Tushare trade_cal refresh (SSE, rolling 9 years).
# The command preserves dates outside the refreshed window and falls back to AkShare/Sina.
15 7 1 * * root /bin/bash -lc 'cd /root/workspace/ifund/backend && set -a; . /etc/ifund-prod.env; set +a; { /usr/bin/flock -n -E 75 /run/lock/ifund-trade-calendar.lock /usr/bin/timeout -s TERM -k 30s 10m venv/bin/python3.12 scripts/sync_trade_calendar.py; rc=$?; if [ "$rc" -eq 75 ]; then echo "$(/bin/date -Is) trade_calendar skipped: previous run active"; elif [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then echo "$(/bin/date -Is) trade_calendar timed out rc=$rc"; elif [ "$rc" -ne 0 ]; then echo "$(/bin/date -Is) trade_calendar failed rc=$rc"; fi; exit "$rc"; } >> logs/trade_calendar_cron.log 2>&1'
