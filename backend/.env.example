DB_BACKEND=sqlite                 # sqlite（当前唯一实现） | mysql（规划中）
DB_PATH=                          # SQLite 文件路径（默认 backend/data.db）
SECRET_KEY=dev-secret             # JWT 密钥
# AI 定性分析（app/ai_analyze，走 Qoder Agent SDK）
QODER_PERSONAL_ACCESS_TOKEN=      # Qoder 访问令牌（access_token_from_env 读取）
QODER_CLI_PATH=qoder              # qoder CLI 路径；默认走 PATH，装在别处时填绝对路径
# 以下为未来接入 MySQL 时使用（当前未实现，可忽略）
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=ifund
